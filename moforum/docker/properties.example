# 服务器配置
server.servlet.context-path=/api

# 数据库配置（容器内使用服务名连接）
# 把数据库密码改为你自己的
spring.datasource.url=jdbc:mysql://mysql:3306/moforum?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true
spring.datasource.username=root
spring.datasource.password=your_db_password

# Redis 配置
spring.data.redis.host=redis
spring.data.redis.port=6379
spring.data.redis.password=your_redis_password

# JWT 配置（建议使用 32 位以上随机字符串）
jwt.secret=your_jwt_secret_key_at_least_32_characters
jwt.expiration=86400000

# 阿里云 OSS 配置
oss.endpoint=oss-cn-beijing.aliyuncs.com
oss.access-key=your_oss_access_key
oss.secret-key=your_oss_secret_key
oss.bucket=your_bucket_name
oss.max-size=3145728